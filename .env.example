# Copy to .env and fill in. Nothing here is required to run the demo.

# --- warehouse -------------------------------------------------------------
# Default is SQLite at data/processed/warehouse.db. Point at Postgres to scale:
# INTELLIOPS_DB_URL=postgresql+psycopg2://intelliops:intelliops@localhost:5432/intelliops

# --- LLM provider for the RAG assistant ------------------------------------
# Without a key the assistant answers via deterministic synthesis over retrieved evidence.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# --- optional overrides -----------------------------------------------------
# INTELLIOPS_CONFIG=configs/config.yaml
# MLFLOW_TRACKING_URI=sqlite:///artifacts/mlflow.db
