# data & artifacts (regenerated by `make all`)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
artifacts/models/*
!artifacts/models/.gitkeep
artifacts/reports/*
!artifacts/reports/.gitkeep
artifacts/figures/*
!artifacts/figures/.gitkeep
artifacts/mlruns/
mlruns/

# docs screenshots are committed on purpose — the README needs them
!docs/*.png

# python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# env & editors
.env
.DS_Store
.idea/
.vscode/
.ipynb_checkpoints/
