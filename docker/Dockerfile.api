# syntax=docker/dockerfile:1
# Multi-stage build: wheels are compiled once in the builder, so the runtime image
# carries no compilers and runs as a non-root user.

FROM python:3.11-slim AS builder
WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends build-essential libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip wheel --no-cache-dir --wheel-dir /wheels -r requirements.txt

FROM python:3.11-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 intelliops

WORKDIR /app
COPY --from=builder /wheels /wheels
COPY requirements.txt .
RUN pip install --no-cache-dir --no-index --find-links=/wheels -r requirements.txt && rm -rf /wheels

COPY --chown=intelliops:intelliops src/ ./src/
COPY --chown=intelliops:intelliops configs/ ./configs/
COPY --chown=intelliops:intelliops Makefile ./
RUN mkdir -p data/raw data/interim data/processed artifacts/models artifacts/reports artifacts/figures \
    && chown -R intelliops:intelliops /app

USER intelliops
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD curl -fsS http://localhost:8000/health || exit 1

CMD ["uvicorn", "intelliops.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
